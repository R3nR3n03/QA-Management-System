generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum QamsRole {
  QA_TESTER
  QA_ENGINEER
  SENIOR_QA_ENGINEER
  QA_LEAD
}

enum TestCaseLifecycleState {
  DRAFT
  IN_REVIEW
  APPROVED
  RETIRED
}

enum ExecutionLifecycleState {
  PLANNED
  IN_PROGRESS
  FINALIZED
}

enum ExecutionOutcome {
  PASS
  FAIL
  BLOCKED
}

/// The outcome of one attempt to transition a Jira issue
/// (`docs/architecture.md#Jira execution sync`). ABANDONED is terminal: the retry budget is
/// spent and only a person can move it forward.
///
/// SKIPPED is the odd one out: it records a decision NOT to call Jira, so it is the only
/// value here that never involved a request. It exists because the alternative was silence --
/// a finalize that declined to transition wrote no row and no audit event, so "QAMS chose not
/// to" and "QAMS is broken" looked identical from the run screen, and telling them apart
/// meant reading the source. The retry worker ignores it (it queues on FAILED) and it does
/// not settle an issue (that is SUCCEEDED or ABANDONED), so it is inert to every existing
/// query by construction.
enum JiraSyncOutcome {
  SUCCEEDED
  FAILED
  ABANDONED
  SKIPPED
}

/// The outcome of one attempt to post a result comment
/// (`docs/architecture.md#Jira execution sync`).
///
/// Its own enum rather than a reuse of JiraSyncOutcome, and the difference is the point:
/// there is no ABANDONED here because a comment is never retried, so it can never exhaust a
/// budget. A shared enum would carry a state that cannot occur (ADR-0004).
enum JiraCommentOutcome {
  SUCCEEDED
  FAILED
}

/// Which of the three things QAMS does to a defect's Jira issue one attempt was
/// (`docs/architecture.md#Jira defect sync`).
///
/// CREATE raises the bug and is the only one that yields an issue key -- every later action
/// on that defect is addressed to the key CREATE returned, so a defect with no key has
/// nothing the other two could act on.
///
/// COMMENT narrates one lifecycle transition. TRANSITION moves the issue to a done status
/// when the defect closes.
///
/// A discriminator column here, where the execution sync uses two separate tables, and the
/// difference is not an inconsistency: an execution's transition speaks for an issue key
/// shared by many runs while its comment speaks for one run, so the two are read by
/// different queries at different grains. All three of these speak for exactly one defect
/// and are read together, as one timeline on the defect screen (ADR-0006).
enum JiraDefectAction {
  CREATE
  COMMENT
  TRANSITION
}

enum DefectLifecycleState {
  NEW
  TRIAGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// Which clock a person's screens draw a stamp on -- `14:30` or `02:30 PM`.
///
/// An enum rather than a nullable boolean deliberately: a `Boolean?` would have three states
/// with nothing in the name saying which of the two non-null ones is the default, while
/// H24 / H12 / null reads correctly on its own. Purely presentation, like the zone beside it:
/// it changes what a reader sees and never what is stored or what a query returns (ADR-0007).
enum HourFormat {
  H12
  H24
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String
  passwordHash String
  role         QamsRole
  active       Boolean  @default(true)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  createdBy    String
  updatedAt    DateTime @updatedAt
  updatedBy    String

  /// Sessions issued before this instant are refused. Null means none have been revoked.
  /// Infrastructure for A6 (session revocation), not a documented attribute -- see the
  /// note in src/lib/session.ts on why this is a column on User rather than a Session
  /// entity, which docs/data-model.md does not establish.
  sessionsValidFrom DateTime?

  /// This person's VIEWER ZONE: the IANA zone their own screens render stamps in. A
  /// documented attribute (docs/data-model.md), unlike sessionsValidFrom above -- a zone is
  /// a fact about where somebody sits, which they set themselves on /account.
  ///
  /// NULL means "has never expressed a preference", which is NOT the same as having chosen
  /// the organization's zone: only null follows a deployment that later changes
  /// ORGANIZATION_TIME_ZONE. That difference is why this was never backfilled (ADR-0007).
  timeZone String?

  /// Whether this person's screens draw a stamp on a 12- or 24-hour clock. The second half
  /// of their display preferences, alongside timeZone above.
  ///
  /// NULL carries the same meaning it does there -- "has never chosen" -- and resolves to
  /// H24, which is what every screen rendered before this column existed. Unlike the zone
  /// there is no deployment-level counterpart to fall through to: the only other audience
  /// for a stamp is a reader in Jira, and that surface is fixed at 24-hour rather than
  /// configurable (ADR-0007).
  hourFormat HourFormat?

  executions TestExecution[] @relation("ExecutionTester")
  jiraCredential JiraCredential?
  jiraSyncAttempts JiraSyncAttempt[] @relation("JiraSyncActor")
  jiraCommentAttempts JiraCommentAttempt[] @relation("JiraCommentActor")
  jiraDefectAttempts JiraDefectAttempt[] @relation("JiraDefectActor")
}

model ControlledValue {
  id        String   @id @default(uuid())
  catalogue String
  value     String
  active    Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  updatedBy String

  @@unique([catalogue, value])
}

model Product {
  id         String   @id @default(uuid())
  businessId String   @unique
  name       String
  versionTag String
  status     String
  /// The Jira project that defects against this product are raised in
  /// (`docs/architecture.md#Jira defect sync`, ADR-0006).
  ///
  /// Catalogue data rather than deployment configuration, and deliberately so: which Jira
  /// project a product's bugs belong in is a fact ABOUT that product, and one QA Lead
  /// maintaining four products should not need a deployment to edit an environment file and
  /// restart to say so. It sits here beside the product's name and version for the same
  /// reason those do.
  ///
  /// This is not a secret, which is what makes it safe to move out of the environment. The
  /// client id, the client secret and the encryption key remain there and are never exposed
  /// at any role (`src/lib/jira-config.ts`).
  ///
  /// Null means defects against this product raise nothing. That is the default for every
  /// product, so the sync stays off until someone names a project — the property the
  /// retired `JIRA_DEFECT_PROJECT_KEY` used to carry.
  ///
  /// Deliberately NOT unique: two products may legitimately share one Jira project, which is
  /// exactly what a team consolidating its bugs would do.
  jiraProjectKey String?
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  createdBy  String
  updatedAt  DateTime @updatedAt
  updatedBy  String

  modules   Module[]
  testCases TestCase[]

  /// The catalogue explorer's search is `ILIKE '%needle%'` across this column
  /// (`searchCatalogue`, `src/domain/catalogue.ts`). A leading wildcard cannot use a
  /// btree index at all, so this is a trigram GIN index — the only kind that can serve
  /// it. Requires the `pg_trgm` extension, created by the migration that adds these.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
}

model Module {
  id         String   @id @default(uuid())
  businessId String   @unique
  name       String
  productId  String
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  createdBy  String
  updatedAt  DateTime @updatedAt
  updatedBy  String

  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  features Feature[]
  testCases TestCase[]

  /// PostgreSQL does NOT index a foreign key automatically — only primary keys and
  /// unique constraints get one. Every `@@index` in this schema is therefore either a
  /// foreign key that is joined or filtered on, or a column a query actually sorts or
  /// filters by; the query is named in each case. Columns already covered by the
  /// LEADING column of a unique index (e.g. `TestStep.testCaseId` via
  /// `@@unique([testCaseId, sequence])`) are deliberately NOT repeated here.
  @@index([productId])

  /// The catalogue explorer's search is `ILIKE '%needle%'` across this column
  /// (`searchCatalogue`, `src/domain/catalogue.ts`). A leading wildcard cannot use a
  /// btree index at all, so this is a trigram GIN index — the only kind that can serve
  /// it. Requires the `pg_trgm` extension, created by the migration that adds these.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Module_name_trgm_idx")
}

model Feature {
  id         String   @id @default(uuid())
  businessId String   @unique
  name       String
  moduleId   String
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  createdBy  String
  updatedAt  DateTime @updatedAt
  updatedBy  String

  module       Module        @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  requirements Requirement[]
  testCases    TestCase[]

  /// Joined by the per-product release-readiness read, which reaches test cases
  /// through `feature.module.productId` (`src/domain/traceability.ts`).
  @@index([moduleId])

  /// The catalogue explorer's search is `ILIKE '%needle%'` across this column
  /// (`searchCatalogue`, `src/domain/catalogue.ts`). A leading wildcard cannot use a
  /// btree index at all, so this is a trigram GIN index — the only kind that can serve
  /// it. Requires the `pg_trgm` extension, created by the migration that adds these.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Feature_name_trgm_idx")
}

model Requirement {
  id         String   @id @default(uuid())
  businessId String   @unique
  statement  String
  featureId  String
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  createdBy  String
  updatedAt  DateTime @updatedAt
  updatedBy  String

  feature  Feature   @relation(fields: [featureId], references: [id], onDelete: Restrict)
  testCases TestCase[]
  rtmLinks  RequirementTraceLink[]

  @@index([featureId])

  /// The catalogue explorer's search is `ILIKE '%needle%'` across this column
  /// (`searchCatalogue`, `src/domain/catalogue.ts`). A leading wildcard cannot use a
  /// btree index at all, so this is a trigram GIN index — the only kind that can serve
  /// it. Requires the `pg_trgm` extension, created by the migration that adds these.
  /// The largest of the four tables and the longest text in them, so this is the one
  /// that most needs it.
  @@index([statement(ops: raw("gin_trgm_ops"))], type: Gin, map: "Requirement_statement_trgm_idx")
}

model TestCase {
  id              String                 @id @default(uuid())
  businessId      String                 @unique
  productId       String
  moduleId        String
  featureId       String
  requirementId   String
  cycle           String
  sprint          String
  release         String
  environment     String
  priority        String
  severity        String
  title           String
  objective       String
  expectedResult  String
  lifecycleState  TestCaseLifecycleState @default(DRAFT)
  authorUserId    String
  reviewReason    String?
  retirementReason String?
  revisesTestCaseId String?
  version         Int                    @default(1)
  createdAt       DateTime               @default(now())
  createdBy       String
  updatedAt       DateTime               @updatedAt
  updatedBy       String

  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  module       Module       @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  feature      Feature      @relation(fields: [featureId], references: [id], onDelete: Restrict)
  requirement  Requirement  @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  revisesTestCase   TestCase?  @relation("TestCaseRevision", fields: [revisesTestCaseId], references: [id], onDelete: SetNull)
  revisions         TestCase[] @relation("TestCaseRevision")
  steps            TestStep[]
  executionCases   ExecutionTestCase[]
  executionHistory ExecutionHistory[]
  defects          Defect[]
  rtmLinks         RequirementTraceLink[]

  /// The review queue counts by state (`countTestCasesInReview`) and the dashboard
  /// excludes Retired cases — both scan the whole table without this.
  @@index([lifecycleState])
  /// The four hierarchy foreign keys. Every one is validated on create/update and
  /// joined by the traceability and release-readiness reads.
  @@index([productId])
  @@index([moduleId])
  @@index([featureId])
  @@index([requirementId])
  /// Self-relation for supersede/revision chains.
  @@index([revisesTestCaseId])
}

model TestStep {
  id             String   @id @default(uuid())
  testCaseId     String
  sequence       Int
  action         String
  expectedResult String
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  createdBy      String
  updatedAt      DateTime @updatedAt
  updatedBy      String

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, sequence])
}

model TestExecution {
  id               String                  @id @default(uuid())
  businessId       String                  @unique
  /// What this run exists to check, in one line -- "Sprint 24 regression, Chrome"
  /// (`docs/business-rules-and-validation.md`). Required, capped at 120 characters, and
  /// settable only while Planned, on the same rule that freezes the tester.
  ///
  /// Deliberately NOT unique and never an identifier: a browser matrix and a rerun are
  /// several runs that SHOULD read alike, the same reasoning as `jiraIssueKey` below.
  /// `businessId` is the only thing that identifies a run.
  purpose          String
  testerId         String
  state            ExecutionLifecycleState @default(PLANNED)
  /// Derived at finalize from the per-case results on `cases`:
  /// FAIL if any case failed, else BLOCKED if any case is blocked, else PASS
  /// (`docs/business-rules-and-validation.md:30`).
  result           ExecutionOutcome?
  startedAt        DateTime?
  finalizedAt      DateTime?
  version          Int                     @default(1)
  createdAt        DateTime                @default(now())
  createdBy        String
  updatedAt        DateTime                @updatedAt
  updatedBy        String

  /// The Jira issue this run is testing (`docs/data-model.md`). Optional, deliberately NOT
  /// unique -- a browser matrix, a re-run and a regression pass all carry the same key, and
  /// that is exactly why one finalized execution is never enough to transition the issue.
  /// Settable only while Planned; see `ensureIssueKeyMutable` in src/domain/jira-sync.ts.
  jiraIssueKey     String?

  tester     User               @relation("ExecutionTester", fields: [testerId], references: [id], onDelete: Restrict)
  cases      ExecutionTestCase[]
  history    ExecutionHistory[]
  defects    DefectExecutionLink[]
  jiraSyncAttempts JiraSyncAttempt[]
  jiraCommentAttempts JiraCommentAttempt[]

  /// My work: the tester's open queue (`where testerId, state != FINALIZED`) and their
  /// full run list. Leading `testerId` serves the testerId-only query too.
  @@index([testerId, state])
  /// Dashboard: `count`/`groupBy` over finalized runs.
  @@index([state])
  /// The execution list sorts newest-first.
  @@index([createdAt])
  /// `shouldTransitionIssue` needs every execution sharing an issue key, so this is read on
  /// each finalize of a linked run rather than only by a report.
  @@index([jiraIssueKey])
}

/// One attempt to transition a Jira issue, and how it went
/// (`docs/data-model.md`, `docs/architecture.md#Jira execution sync`).
///
/// Its own table rather than columns on TestExecution because a Finalized execution is
/// immutable: there is nowhere on the execution to record an outcome that arrives after it
/// finalized, and nowhere to update when a retry changes that outcome. Append-only, on the
/// same rule as ExecutionHistory.
model JiraSyncAttempt {
  id            String          @id @default(uuid())
  executionId   String
  jiraIssueKey  String
  attemptedAt   DateTime        @default(now())
  outcome       JiraSyncOutcome
  /// Why it failed, for a QA Lead reading the failure list. Never carries token material.
  failureReason String?
  /// The user whose credential performed the write, or null when the service-account
  /// fallback did. Null is how a reader tells a bot-attributed transition from a human one.
  /// A real foreign key, like every other actor reference here: docs/data-model.md relies on
  /// actor references staying resolvable forever, and the QA Lead failure view joins this to
  /// a display name. No user row is ever deleted, so Restrict never fires in practice.
  actorId       String?

  execution TestExecution @relation(fields: [executionId], references: [id], onDelete: Restrict)
  actor     User?         @relation("JiraSyncActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([executionId])
  /// The QA Lead failure view filters on the terminal state.
  @@index([outcome])
  @@index([jiraIssueKey])
}

/// One attempt to post a result comment on a Jira issue, and how it went
/// (`docs/data-model.md`, `docs/architecture.md#Jira execution sync`).
///
/// A separate table rather than a `kind` column on JiraSyncAttempt, because three queries read
/// every row of that table as the transition's story and sharing it would silently break the
/// transition in both directions. The reasoning is in ADR-0004 and is not repeated here.
///
/// Append-only, on the same rule as ExecutionHistory and JiraSyncAttempt.
model JiraCommentAttempt {
  id            String             @id @default(uuid())
  executionId   String
  jiraIssueKey  String
  attemptedAt   DateTime           @default(now())
  outcome       JiraCommentOutcome
  /// Jira's id for the comment this created, on success.
  ///
  /// Nothing reads it today. It is stored because it is the only handle QAMS will ever have on
  /// something it created in another system, and the plausible next asks -- do not double-post,
  /// update the comment on a re-run, withdraw it -- are all impossible without it. Recovering
  /// it later would mean searching an issue's comments trying to recognise our own.
  jiraCommentId String?
  /// Why it failed, for the run screen and a QA Lead. Never carries token material.
  failureReason String?
  /// The user whose credential performed the write, or null when no credential could be used
  /// at all. Same contract, and the same real foreign key, as JiraSyncAttempt.actorId.
  actorId       String?

  execution TestExecution @relation(fields: [executionId], references: [id], onDelete: Restrict)
  actor     User?         @relation("JiraCommentActor", fields: [actorId], references: [id], onDelete: Restrict)

  /// The run screen reads the latest attempt for one execution. The only access path there
  /// is, and so the only index.
  ///
  /// Deliberately NOT indexed on jiraIssueKey, unlike JiraSyncAttempt: a transition is a
  /// property of the key and is decided by reading every row sharing one, while a comment
  /// belongs to a single run and nothing groups comments by issue. Nor on `outcome`, which
  /// its sibling indexes for a QA Lead failure view -- a comment is never retried and has no
  /// such view, and an index nothing reads is write cost for a query nobody makes.
  @@index([executionId])
}

/// One attempt to create, comment on, or transition a defect's Jira issue
/// (`docs/data-model.md`, `docs/architecture.md#Jira defect sync`).
///
/// One table for all three actions, discriminated by `action` -- see JiraDefectAction for why
/// this does not follow the two-table split on the execution side (ADR-0006).
///
/// `jiraIssueKey` is nullable here and nowhere else in this schema, because a failed CREATE is
/// the one attempt that can exist before any issue key does. That row is the entire record
/// that QAMS tried to raise a bug and could not, so refusing to store it -- or inventing a key
/// for it -- would lose the failure the retry worker exists to pick up.
///
/// Append-only, on the same rule as ExecutionHistory, JiraSyncAttempt and JiraCommentAttempt.
model JiraDefectAttempt {
  id            String           @id @default(uuid())
  defectId      String
  action        JiraDefectAction
  /// Null only on a CREATE that never got far enough to have one. See the note above.
  jiraIssueKey  String?
  attemptedAt   DateTime         @default(now())
  outcome       JiraSyncOutcome
  /// Jira's id for the comment a COMMENT row created, on success. Null for every other
  /// action. Stored for the same reason as JiraCommentAttempt.jiraCommentId: it is the only
  /// handle QAMS will ever have on something it wrote into another system.
  jiraCommentId String?
  /// Why it failed, for the defect screen and a QA Lead. Never carries token material --
  /// `sanitizeFailureReason` runs over every value written here.
  failureReason String?
  /// The user whose credential performed the write, or null when the service-account
  /// fallback did, or when no credential could be used at all. Same contract and the same
  /// real foreign key as JiraSyncAttempt.actorId.
  actorId       String?

  defect Defect @relation(fields: [defectId], references: [id], onDelete: Cascade)
  actor  User?  @relation("JiraDefectActor", fields: [actorId], references: [id], onDelete: Restrict)

  /// The defect screen reads this defect's attempts, newest first.
  @@index([defectId, attemptedAt])
  /// The retry worker queues on (action, outcome): failed CREATEs and TRANSITIONs, never
  /// COMMENTs. A QA Lead failure view filters the same pair.
  @@index([action, outcome])
}

/// One user's stored Jira connection (`docs/data-model.md`).
///
/// The refresh token is encrypted at rest and is the first third-party secret QAMS holds --
/// until now the only secret at rest was a password hash. It is never returned by the API,
/// rendered in a screen, or written to an audit event
/// (`docs/api-and-security.md#Authorization and security`).
model JiraCredential {
  id                    String   @id @default(uuid())
  userId                String   @unique
  encryptedRefreshToken String
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One covered test case of an execution (`docs/data-model.md:25`). The per-case
/// result, actual result and block reason live here; the execution keeps only its
/// derived result. Selected together at planning, written exactly once at finalize.
model ExecutionTestCase {
  id           String            @id @default(uuid())
  executionId  String
  testCaseId   String
  result       ExecutionOutcome?
  actualResult String?
  blockReason  String?
  createdAt    DateTime          @default(now())
  createdBy    String
  updatedAt    DateTime          @updatedAt
  updatedBy    String

  execution TestExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  testCase  TestCase      @relation(fields: [testCaseId], references: [id], onDelete: Restrict)

  @@unique([executionId, testCaseId])
  /// `executionId` is already the leading column of the unique index above; the
  /// TRAILING one is not reachable by it, and coverage reads filter by test case.
  @@index([testCaseId])
}

model ExecutionHistory {
  id          String   @id @default(uuid())
  executionId String
  testCaseId  String
  result      ExecutionOutcome
  occurredAt  DateTime
  createdAt   DateTime @default(now())
  createdBy   String

  execution TestExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  testCase  TestCase      @relation(fields: [testCaseId], references: [id], onDelete: Restrict)

  /// The execution detail page reads one run's history in `occurredAt` order.
  @@index([executionId, occurredAt])
  /// Release readiness counts finalized history rows per test case.
  @@index([testCaseId])
}

model Defect {
  id                String               @id @default(uuid())
  businessId        String               @unique
  testCaseId        String
  summary           String
  status            DefectLifecycleState @default(NEW)
  priority          String
  severity          String
  investigationOwnerId String?
  resolutionSummary String?
  closureRationale  String?
  retestEvidenceRef String?
  /// The Jira bug QAMS raised for this defect, written back once creation succeeds
  /// (`docs/data-model.md`, `docs/architecture.md#Jira defect sync`).
  ///
  /// Null means no issue exists yet: Jira is not configured, no project key is set, the
  /// create has not run, or every attempt at it failed. It is never null because a person
  /// declined to link one -- QAMS raises the bug or nothing does, and unlike an execution's
  /// key this is never typed in by hand.
  ///
  /// Unique, unlike TestExecution.jiraIssueKey which many runs deliberately share. One
  /// defect is one bug: a second defect pointing at the same issue would make the lifecycle
  /// comments below it contradict each other, and it is the database constraint rather than
  /// a rule in a service that makes a retry unable to adopt an issue already claimed.
  jiraIssueKey      String?              @unique
  version           Int                  @default(1)
  createdAt         DateTime             @default(now())
  createdBy         String
  updatedAt         DateTime             @updatedAt
  updatedBy         String

  testCase  TestCase                 @relation(fields: [testCaseId], references: [id], onDelete: Restrict)
  executions DefectExecutionLink[]
  rtmLinks  RequirementTraceLink[]
  jiraAttempts JiraDefectAttempt[]

  /// `listOpenDefectsForCases` — the finalize form's defect picker — filters exactly
  /// this pair (`testCaseId IN (…) AND status <> CLOSED`).
  @@index([testCaseId, status])
  /// Dashboard: open-defect count and the severity `groupBy`.
  @@index([status])
  /// The defect list sorts newest-first.
  @@index([createdAt])
}

model DefectExecutionLink {
  defectId    String
  executionId String
  createdAt   DateTime @default(now())
  createdBy   String

  defect    Defect        @relation(fields: [defectId], references: [id], onDelete: Cascade)
  execution TestExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@id([defectId, executionId])
  /// `defectId` leads the composite primary key; `executionId` needs its own index
  /// so the cascade from a deleted execution does not scan this table.
  @@index([executionId])
}

model RequirementTraceLink {
  id            String   @id @default(uuid())
  requirementId String
  testCaseId    String
  defectId      String?
  createdAt     DateTime @default(now())
  createdBy     String

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  testCase    TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Restrict)
  defect      Defect?     @relation(fields: [defectId], references: [id], onDelete: SetNull)

  /// IMPORTANT: this line is not the whole constraint, and Prisma cannot express the rest.
  ///
  /// `docs/data-model.md:27` calls for uniqueness on (requirementId, testCaseId, defectId).
  /// Written like this the generated index takes it literally, and PostgreSQL never treats
  /// two NULLs as equal — so it deduplicated NOTHING whenever `defectId` was NULL, which
  /// `docs/business-rules-and-validation.md:36` explicitly permits. Unlimited identical
  /// (requirement, testCase, NULL) rows were insertable.
  ///
  /// Migration `20260731110000_rtm_unique_nulls_not_distinct` recreates this index with
  /// `NULLS NOT DISTINCT` (PostgreSQL 15+). Prisma has no syntax for that, so the schema
  /// cannot show it — verified that `prisma migrate dev` does NOT see it as drift and will
  /// not revert it, but **anyone regenerating this index from scratch must reapply that
  /// migration**, or the NULL case silently stops being unique again.
  @@unique([requirementId, testCaseId, defectId])
  /// `requirementId` leads the unique index above; these two do not, and the RTM
  /// screen pivots on both. Adding them does not touch that index, so the
  /// `NULLS NOT DISTINCT` migration described above is unaffected.
  @@index([testCaseId])
  @@index([defectId])
  /// The RTM list sorts newest-first.
  @@index([createdAt])
}

model ImportRun {
  id            String   @id @default(uuid())
  sourceFileName String
  sourceFileHash String?
  actorId       String
  status        String
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  reportJson    Json
  createdAt     DateTime @default(now())
  createdBy     String

  rows ImportRowReport[]
}

model ImportRowReport {
  id           String   @id @default(uuid())
  importRunId  String
  sourceSheet  String
  sourceRow    Int
  outcome      String
  errorCode    String?
  recordId     String?
  details      String?
  proposedValuesJson Json?
  resolutionDecision String?
  resolutionRationale String?
  resolvedAt   DateTime?
  resolvedBy   String?
  createdAt    DateTime @default(now())
  createdBy    String

  importRun ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)

  /// One import writes a row per source row; the run's report reads them all back.
  @@index([importRunId])
}

/// Counter row per business-ID sequence (`docs/data-model.md:5`): `execution`,
/// `defect`, and `testCase:<productBusinessId>` (test cases number per product).
/// `next` is the next number to try; allocation locks the row (UPDATE ... RETURNING)
/// and probes past occupied numbers, so imported IDs sitting ahead of the counter are
/// skipped, never duplicated. Seeded lazily on first use — no backfill migration.
model IdSequence {
  key  String @id
  next Int
}

model AuditEvent {
  id              String   @id @default(uuid())
  occurredAt      DateTime @default(now())
  actorId         String
  action          String
  entityType      String
  entityId        String
  requestId       String
  beforeAfterJson Json

  /// Append-only and never pruned, so this is the table that grows fastest and the one
  /// where a missing index hurts most later. Nothing in `src/` reads it back yet — the
  /// access paths indexed here are the ones an audit question actually takes: the
  /// history of one record, a time window, and everything one actor did.
  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([actorId])
}
