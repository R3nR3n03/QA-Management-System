{
  "version": 1,
  "commands": {
    "setup": "npm install && npm run prisma:generate",
    "build": "npm run build",
    "test": "npm run test",
    "lint": "npm run lint",
    "typecheck": "npm run typecheck"
  },
  "gates": {
    "required": ["build", "lint", "test"],
    "advisory": ["typecheck"]
  },
  "git": {
    "defaultBranch": "main",
    "coAuthor": true
  },
  "ship": { "stopAfter": "commit" }
}
