# dependencies
node_modules/

# next.js
.next/
out/

# env — secrets stay out of the repo; .env.example is the template
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# relay run state
.relay/

# testing / coverage
coverage/

# editor and OS files
.vscode/
.DS_Store

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# build output
/dist/
/build/

# local databases / sqlite
*.sqlite
*.sqlite3

# misc
.cache/
.turbo/

# cypress artifacts — runs produce these, the suite is the source of truth
cypress/screenshots/
cypress/videos/
cypress/downloads/
cypress/.seed.json

# Claude Code: skills under .claude/skills/ are shared and tracked; everything the
# tool writes while running is per-machine and is not
.claude/scheduled_tasks.lock
.claude/settings.local.json
