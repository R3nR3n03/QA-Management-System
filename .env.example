DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qams?schema=public"
SESSION_SECRET="replace-with-a-long-random-value-per-deployment-environment"

# How long a session cookie stays valid, in hours. Optional; defaults to 12, which is the
# pre-existing behaviour. docs/ establishes no session TTL, so this is a deployment value
# and NOT a documented rule -- it wants QA Lead confirmation.
#
# It exists so a deployment can shrink the exposure window A6 describes without a code
# change. An unusable value (blank, non-numeric, zero, negative) falls back to the default,
# and a value above 24 is capped there: a typo can fail to shorten the window, it can never
# lengthen it without bound.
#
# Sessions can now also be revoked outright -- signing out stamps User.sessionsValidFrom and
# every token issued before that instant is refused, on every device.
SESSION_TTL_HOURS="12"

# Optional; leave unset. The session cookie is marked Secure whenever NODE_ENV=production,
# which is correct once a real deployment terminates TLS in front of the app -- but
# PRODUCTION-READINESS-2026-07-31.md D1 is blunt that no such deployment exists yet, so
# today "production" usually means `next start` (or the standalone server) run locally over
# plain http. A Secure cookie is never stored over http: the browser drops it silently, and
# every navigation after login -- including expanding a tree node -- looks like a fresh
# unauthenticated request and bounces to /login.
#
# Set SESSION_COOKIE_SECURE="false" ONLY to exercise a production build over plain http.
# Unset it (do not set it to any other value) the moment TLS sits in front of the app --
# this is a workaround for the missing deployment pipeline, not a setting to carry forward.
# SESSION_COOKIE_SECURE="false"

# Largest accepted workbook upload, in bytes. Optional; defaults to 10485760 (10 MB).
# api-and-security.md:43 places the exact limits for this endpoint outside the
# knowledge base ("deployment policy"), so this default is NOT a documented rule and
# wants QA Lead confirmation before deployment. An unusable value falls back to the
# default rather than removing the limit.
MAX_UPLOAD_BYTES="10485760"

# --- Rate limiting -----------------------------------------------------------
# api-and-security.md:43 requires authentication and import endpoints to be rate
# limited but places the exact limits outside the knowledge base ("deployment
# policy"). All four values below are therefore deployment defaults, NOT documented
# rules, and want QA Lead confirmation before deployment. An unusable value (blank,
# non-numeric, zero, negative, fractional) falls back to the default rather than
# disabling the throttle.
#
# The limiter is in-memory and therefore PER PROCESS: two instances behind a load
# balancer give twice the limit, and a restart clears every counter. It is a speed
# bump against naive brute force, not a distributed control.

# Sign-in allowance per window. One number, spent against two separate buckets:
#   * the hashed email address — EVERY attempt, successful or not. This is the
#     dimension that actually holds, because an attacker cannot rotate it without
#     abandoning the account being attacked.
#   * the caller's forwarded address — FAILED attempts only. A successful sign-in
#     costs it nothing, deliberately: everyone behind one NAT egress address shares
#     this bucket, so charging successes to it would lock out a whole office, while
#     an attacker escapes it by sending their own x-forwarded-for header.
# Optional; defaults to 10.
RATE_LIMIT_AUTH_MAX="10"

# Length of the sign-in window in milliseconds. Fixed window, not sliding: a caller
# can spend the full allowance either side of a boundary. Optional; defaults to
# 900000 (15 minutes).
RATE_LIMIT_AUTH_WINDOW_MS="900000"

# Workbook imports allowed per window per authenticated user. Optional; defaults to 5.
RATE_LIMIT_IMPORT_MAX="5"

# Length of the import window in milliseconds. Optional; defaults to 3600000 (1 hour).
RATE_LIMIT_IMPORT_WINDOW_MS="3600000"

# --- Cross-site request forgery ----------------------------------------------
# Comma-separated hostnames (optionally with a port) that Next should accept as the
# origin of a server-action POST, on top of its own same-origin check. Set this only
# when a proxy or load balancer rewrites Host, so the app no longer recognises the
# hostname users actually reach it by.
#
# LEAVE IT UNSET unless that is true. Unset omits the setting entirely and Next's
# default same-origin check applies, which is the safe position; an empty list is a
# configuration statement, not the same thing. There is no deployed hostname for this
# project yet, so this value is undocumented and is a QA Lead / deployment decision.
# ALLOWED_ORIGINS="qams.example.com"

# --- This deployment's public address ----------------------------------------
# Optional. Where QAMS is reachable from outside, e.g. https://qams.example.com.
#
# Every link QAMS renders in its own screens is relative, so nothing needed this until a
# result comment had to link a Jira reader back to the run it describes. Unset, that comment
# simply carries no link -- a smaller loss than a link that goes somewhere wrong.
#
# A value that is set but is not an absolute http(s) URL stops the process at boot. That is
# deliberate: the alternative is a dead link discovered by a stranger in someone else's Jira
# ticket, weeks after whoever typed it could connect the two.
# APP_BASE_URL="https://qams.example.com"

# --- This deployment's time zone ---------------------------------------------
# Optional. An IANA zone name -- Asia/Manila, Europe/London -- and NOT an offset like
# "+08:00" or an abbreviation like "PHT", both of which are rejected. docs/ establishes only
# that stored timestamps are UTC, so this is a deployment value and NOT a documented rule --
# it wants QA Lead confirmation. See docs/adr/0007.
#
# This is the ORGANIZATION ZONE: the zone QAMS speaks in where there is no reader to consult
# -- today, the stamps on the comments it writes into Jira, read by people who are not QAMS
# users and have no preference of their own. It also serves as the default for anyone who has
# not chosen a zone on /account. It governs NO query: nothing in QAMS buckets by calendar day,
# so this changes how instants are shown and never which records come back.
#
# UNSET means UTC, which is exactly how this deployment rendered before the setting existed.
# That is deliberate, like JIRA_COMMENT_ON_FINALIZE below: an upgrade must not quietly start
# writing different text into another team's tickets.
#
# A value that IS set but is not a zone this runtime recognises stops the process at boot,
# like APP_BASE_URL above and unlike SESSION_TTL_HOURS. The failures are not symmetrical: a
# typo such as "Asia/Manilla" falling back to UTC would put every stamp eight hours out, in a
# project QAMS does not own, with nothing anywhere looking wrong.
# ORGANIZATION_TIME_ZONE="Asia/Manila"

# --- Jira execution sync -----------------------------------------------------
# One-way sync from QAMS to Jira: when every execution carrying a Jira issue key is
# Finalized and all of them passed, QAMS transitions that issue to its workflow's
# `done`-category status. See docs/architecture.md#Jira execution sync.
#
# LEAVE EVERY VARIABLE BELOW UNSET unless you use Jira. Unset means the integration is
# off and the app boots normally. Setting SOME of the three required values but not all
# is treated as a deployment mistake and the app REFUSES TO START, naming what is
# missing -- a half-configured integration otherwise looks like it works and silently
# never syncs.
#
# These are secrets. They are never returned by an API, never rendered in a screen, and
# never written to an audit event (docs/api-and-security.md#Authorization and security).
# The admin screen shows only whether Jira is connected and its base URL.

# Required together. Your Jira site, the OAuth app you registered against it, where Jira
# sends people back, and the key their stored refresh tokens are encrypted with.
#
# JIRA_REDIRECT_URI must match the callback registered on the Jira OAuth app exactly, or
# Jira refuses the handshake.
#
# JIRA_ENCRYPTION_KEY is 32 bytes of base64 -- generate with `openssl rand -base64 32`.
# There is no default and there cannot be one: a generated key would make every stored
# credential undecryptable on the next restart. Rotating it has the same effect, so treat it
# like the database password. It is checked at boot, not at first use.
# JIRA_BASE_URL="https://your-team.atlassian.net"
# JIRA_OAUTH_CLIENT_ID=""
# JIRA_OAUTH_CLIENT_SECRET=""
# JIRA_REDIRECT_URI="https://qams.example.com/api/v1/jira/callback"
# JIRA_ENCRYPTION_KEY=""

# Optional. A service-account credential used ONLY when the user whose run triggered the
# sync has no usable Jira token -- never connected, revoked, expired, or unauthorized on
# that project.
#
# Presence alone enables the fallback; there is no separate on/off flag, so the decision
# and the credential that makes it possible can never disagree. UNSET means per-user
# OAuth only: a transition is always attributed to a real person, and an expired token
# strands that issue until someone intervenes. SET means an issue is never stranded, at
# the cost of some transitions appearing in Jira as the service account rather than a
# person -- where that happens the QAMS audit event is the only record of the real actor.
# JIRA_SERVICE_ACCOUNT_TOKEN=""

# Optional. How long a single transition may take before QAMS stops waiting, in
# milliseconds. Defaults to 5000. An unusable value falls back to the default rather than
# failing, because the default is the conservative direction. Finalize awaits this call,
# so the deadline is what stops a HANGING Jira from holding a tester's request open after
# their work has already committed.
#
# It bounds the result comment below as well, as a SEPARATE deadline rather than a shared
# budget -- so against a hanging Jira a finalize can wait up to twice this. The comment is
# attempted first and the transition second, and one budget across both would let the
# cosmetic half starve the half that carries meaning (ADR-0004).
# JIRA_TRANSITION_TIMEOUT_MS="5000"

# Optional, and OFF unless set. Posts a result comment on a run's Jira issue every time that
# run finalizes -- what passed, what failed with its defect, what was blocked and why
# (docs/architecture.md#Jira execution sync).
#
# Off by default on purpose, unlike everything else here. A transition is invisible until
# someone looks at an issue's status; a comment is conversation, in a space QAMS does not own
# and shares with people who have never heard of it. A deployment that upgraded while only
# ever asking for transitions must not start writing into its tickets on its own.
#
# Recognised affirmatives: true, 1, yes, on (any case). Anything else leaves it off, so a
# typo can fail to enable this but can never enable it by accident.
#
# Unlike a transition, a comment is never retried: if it fails, the run screen says so and
# nothing chases it. The results are in QAMS either way.
# JIRA_COMMENT_ON_FINALIZE="true"

# Optional, one variable per Jira project. Forces a specific transition id for that
# project instead of resolving one by `done` status category. The project key is the
# variable's suffix, so JIRA_TRANSITION_OVERRIDE_PROJ applies to issues PROJ-1, PROJ-2...
# Use this only for a workflow with several done-category statuses where it matters which
# one is chosen.
# JIRA_TRANSITION_OVERRIDE_PROJ="31"

# The Jira project that defects become bugs in is NOT configured here. It is set per product,
# in the Catalogue, on the product itself -- which Jira project a product's bugs belong in is
# a fact about that product, and different products go to different projects. See ADR-0006.
#
# A product with no project key raises nothing, which is the default for every product, so
# the defect sync stays off until a QA Lead names a project. Weigh that before naming one:
# everything else here annotates issues someone already made, while this CREATES records in
# another team's project, one per defect raised, and they do not disappear if you change your
# mind. Point a product at a project your team owns.
#
# Optional. The issue type created for a raised defect, defaulting to `Bug` -- Jira's own
# default name for it, which exists in every stock project. Set this only where your site
# renamed its issue types, since an unrecognised name makes Jira refuse the create outright.
# Unlike the project, this is a fact about the site rather than about one product.
# JIRA_DEFECT_ISSUE_TYPE="Defect"
