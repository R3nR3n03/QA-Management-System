DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qams?schema=public"
SESSION_SECRET="replace-with-a-long-random-value-per-deployment-environment"

# Largest accepted workbook upload, in bytes. Optional; defaults to 10485760 (10 MB).
# api-and-security.md:43 places the exact limits for this endpoint outside the
# knowledge base ("deployment policy"), so this default is NOT a documented rule and
# wants QA Lead confirmation before deployment. An unusable value falls back to the
# default rather than removing the limit.
MAX_UPLOAD_BYTES="10485760"
